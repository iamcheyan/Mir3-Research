<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>QuestProbe</AssemblyName>
    <RootNamespace>Mir3Research.QuestProbe</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Zircon sources: from MIR3_ZIRCON_ROOT env (see AGENTS.md), fallback to old in-Zircon layout -->
    <ZirconRoot Condition="'$(ZirconRoot)' == '' and '$(MIR3_ZIRCON_ROOT)' != ''">$(MIR3_ZIRCON_ROOT)</ZirconRoot>
    <ZirconRoot Condition="'$(ZirconRoot)' == ''">..\..</ZirconRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只读引用 zircon 协议库（绝不修改 zircon 仓库） -->
    <ProjectReference Include="$(ZirconRoot)\LibraryCore\LibraryCore.csproj" />
  </ItemGroup>

</Project>
