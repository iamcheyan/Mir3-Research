<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AccountProbe</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Zircon sources: from MIR3_ZIRCON_ROOT env (see AGENTS.md), fallback to old in-Zircon layout -->
    <ZirconRoot Condition="'$(ZirconRoot)' == '' and '$(MIR3_ZIRCON_ROOT)' != ''">$(MIR3_ZIRCON_ROOT)</ZirconRoot>
    <ZirconRoot Condition="'$(ZirconRoot)' == ''">..\..</ZirconRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ZirconRoot)\LibraryCore\LibraryCore.csproj" />
    <ProjectReference Include="$(ZirconRoot)\ServerLibrary\ServerLibrary.csproj" />
  </ItemGroup>
</Project>
